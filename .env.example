# Required in production. Development runs without it.
TRENDIFEST_PASSWORD=

# PORT=8787
# TRENDIFEST_DATA_FILE=server/data/state.json
# TRENDIFEST_MONITOR=1

# --- Social collection (optional) -------------------------------------------
# Needs Postgres with the pgvector extension. Without it the keyword MVP still
# runs and /api/signals reports database_unconfigured.
# TRENDIFEST_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/trendifest
# Turns on the live Bluesky tail and the 10-minute segment backfill.
# TRENDIFEST_SOCIAL=1
# Every Nth live create event is embedded; the public tail is far faster than
# local CPU inference. Deletes are never sampled.
# TRENDIFEST_TAIL_SAMPLE=20
# Where the local ONNX models are cached (about 300 MB after first use).
# TRENDIFEST_MODEL_CACHE=.cache/transformers
