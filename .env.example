# Required in production. Development runs without it.
TRENDIFEST_PASSWORD=

# `bun dev`: the single web/API reverse-proxy port (default 5180).
# `bun start` / `bun run dev:api`: the standalone server port (default 8787).
# PORT=5180

# Postgres with pgvector stores collected records, local embeddings, and topics.
# The graph shows setup instructions when no database is configured.
TRENDIFEST_DATABASE_URL=postgres://trendifest:trendifest@127.0.0.1:55433/trendifest
# Enable bounded VOZ/Otofun discussion and Google News VN/Người Việt news collection.
TRENDIFEST_SOCIAL=1
# Local ONNX model cache; models are downloaded lazily on first use.
# TRENDIFEST_MODEL_CACHE=.cache/transformers
