{
  "name": "trendifest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vp dev",
    "build": "tsc --noEmit && vp build",
    "start": "NODE_ENV=production bun server/index.ts",
    "check": "vp check",
    "ci": "bun run check && bun run test --timeout 120000 && bun run build",
    "fmt": "vp fmt",
    "postinstall": "bun scripts/build-obi-graph.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@nodable/entities": "^3.1.0",
    "@tanstack/react-query": "^5.105.0",
    "@trendifest/opendesk": "workspace:*",
    "fast-xml-parser": "^5.12.0",
    "franc-min": "6.2.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.67.0",
    "negotiator": "^1.1.0",
    "obi-graph": "github:tmih06/obi-graph#08bbc78",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/compression": "^1.8.1",
    "@types/d3-force": "^3.0.10",
    "@types/negotiator": "^0.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agentation": "^3.1.2",
    "compression": "^1.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
