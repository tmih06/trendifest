{
  "name": "trendifest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vp dev",
    "build": "tsc --noEmit && vp build",
    "start": "NODE_ENV=production bun server/index.ts",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "bun test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@tanstack/react-query": "^5.105.0",
    "@trendifest/opendesk": "workspace:*",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
